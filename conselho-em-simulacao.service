[Unit]
Description=KeyCore Academy - Workshop interativo
After=network.target

[Service]
Type=simple
User=keyla
WorkingDirectory=/home/keyla/hermes-workspace/conselho-em-simulado
EnvironmentFile=/etc/keycore-workshop.env
ExecStart=/home/keyla/hermes-workspace/conselho-em-simulado/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8101 --workers 1
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
